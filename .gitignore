# Dependencies
node_modules/
.pnpm-store/
# 本地开发用符号链接（共享主仓库依赖），避免误提交
/backend/node_modules
/frontend/node_modules

# Build output
dist/
frontend/dist
build/
.output/
.nuxt/
.nitro/
.cache/
coverage/
