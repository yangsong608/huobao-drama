# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
id_rsa*
id_ed25519*

# Runtime data (SQLite may contain API keys; media/uploads are large)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3.bak*

# Local H3 bridge runtime artifacts
local-h3/scripts/files/
local-h3/scripts/state.json
local-h3/scripts/upload_cache.json
# 独立 git 仓库的 ComfyUI 自定义节点部署（含 __pycache__），不纳入主仓库
local-h3/ComfyUI-MiniMaxH3-WhaleTrans-Director/
__pycache__/
*.py[cod]
.pytest_cache/

# Logs
*.log
logs/

# Desktop (Electron) build artifacts
desktop/node_modules/
desktop/build/
desktop/dist/
desktop/release/
# 二进制与本机前端产物忽略，但保留 workspace-template（提示词/技能源）
desktop/resources/bin-*/
desktop/resources/frontend/
!desktop/resources/workspace-template/

# Agent workspace (skills/prompts 为策划模板保持跟踪，其余产出忽略)
backend/workspace/*
!backend/workspace/skills/
!backend/workspace/prompts/

# Config
configs/config.yaml

# Local audio engine sidecar (Python env and model cache)
tools/audio-engine/.venv/
tools/audio-engine/models/

# H3 gateway admin service virtualenv
local-h3/gateway/.venv/
local-h3/gateway/.venv-admin/
local-h3/gateway/data/
local-h3/gateway/admin.secret
local-h3/gateway/admin/__pycache__/

