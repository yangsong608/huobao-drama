# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
frontend/dist
build/
.output/
.nuxt/
.nitro/
.cache/
coverage/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
id_rsa*
id_ed25519*

# Runtime data (SQLite may contain API keys; media/uploads are large)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3.bak*

# Local H3 bridge runtime artifacts
local-h3/scripts/files/
local-h3/scripts/state.json
local-h3/scripts/upload_cache.json
__pycache__/
*.py[cod]
.pytest_cache/

# Logs
*.log
logs/

# Desktop (Electron) build artifacts
desktop/node_modules/
desktop/build/
desktop/dist/
desktop/release/
# 二进制与本机前端产物忽略，但保留 workspace-template（提示词/技能源）
desktop/resources/bin-*/
desktop/resources/frontend/
!desktop/resources/workspace-template/

# Agent workspace (skills/prompts 为策划模板保持跟踪，其余产出忽略)
backend/workspace/*
!backend/workspace/skills/
!backend/workspace/prompts/

# Config
configs/config.yaml

# Local tooling / agent state
.superpowers/
.zion-mcp/
.qoder/
.claude/
.cursor/
tmp/
temp/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
