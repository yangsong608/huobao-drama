{
  "name": "dsh-moss-huobao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：火宝短剧 LLM/Agent 桥接与业务工具",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
