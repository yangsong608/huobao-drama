{
  "model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "faceswap": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["model", 0],
      "lora_name": "MiniMaxH3/SS_FaceSwap/SS_FaceSwap_MiniMax_H3_REF2VA.safetensors",
      "strength_model": 1.3
    }
  },
  "text": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "source": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "source_video.mp4"
    }
  },
  "frames": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["source", 0]
    }
  },
  "dims": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": ["frames", 0]
    }
  },
  "reference": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "duration_seconds": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 6.0
    }
  },
  "length_frames": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "values.a": ["duration_seconds", 0],
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"
    }
  },
  "conditioning": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["text", 0],
      "vae": ["video_vae", 0],
      "audio_vae": ["audio_vae", 0],
      "prompt": "Faceswap. subject_definitions:\n<Subject 1> is the character shown in <Picture 1>, with the exact face and hairstyle visible in that picture.\n<Subject 2> is the person in <Video 1>, seen performing in the original scene.\nsummary:\n[video editing] The target video is an edited version of <Video 1>. <Subject 2>'s identity is fully replaced: their face, head and hair are entirely those of <Subject 1> as shown in <Picture 1>. Nothing of <Subject 2>'s original face or hair remains anywhere in the video. Preserve <Subject 2>'s outfit, body, performance, movement, expression, mouth timing, camera and surroundings.\nretention_analysis:\n<Subject 1> (appears in [Shot 1]): attribute_transfer - Their exact face and hairstyle as shown in <Picture 1> replace every visible trace of <Subject 2>'s face and original hair, from the first frame to the last.\n<Subject 2> (appears in [Shot 1]): partially_preserved - Only their outfit, body, performance, movement and timing are preserved. Their face and hair are fully replaced by <Subject 1>.\n<Video 1> (camera and surroundings): fully_preserved - Preserve the original framing, background, camera motion and lighting of <Video 1> in every shot.\ndetailed_description:\n[Shot 1] The person on screen IS <Subject 1>, with the exact face and hairstyle shown in <Picture 1>; no trace of <Subject 2>'s original face or hair is visible in any frame. <Subject 1> performs the source performance in the original scene. Render natural scene colors, cinematic quality.",
      "width": ["dims", 0],
      "height": ["dims", 1],
      "length": ["length_frames", 1],
      "ref_image_size": "match",
      "ref_videos.ref_video_0": ["frames", 0],
      "ref_images.ref_image_0": ["reference", 0]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 20261114
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["faceswap", 0],
      "conditioning": ["conditioning", 0]
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "schedule": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["faceswap", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["schedule", 0],
      "latent_image": ["conditioning", 1]
    }
  },
  "decode_video": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["video_vae", 0]
    }
  },
  "decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["audio_vae", 0]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode_video", 0],
      "audio": ["decode_audio", 0],
      "fps": 24,
      "bit_depth": 8,
      "color_space": "sRGB",
      "codec": "none"
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "h3-face-swap",
      "format": "auto",
      "codec": "auto"
    }
  }
}
