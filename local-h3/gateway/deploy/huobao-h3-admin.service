[Unit]
Description=Huobao H3 Gateway Admin
After=network-online.target huobao-h3-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=huobao-h3
Group=huobao-h3
EnvironmentFile=/etc/huobao-h3-gateway.env
WorkingDirectory=/opt/huobao-h3-gateway
ExecStart=/opt/huobao-h3-gateway/.venv-admin/bin/python -m admin.cli serve --host 127.0.0.1 --port 8193
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/huobao-h3-gateway
ProtectHome=true

[Install]
WantedBy=multi-user.target
