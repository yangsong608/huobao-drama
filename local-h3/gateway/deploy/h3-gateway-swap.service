[Unit]
Description=Huobao H3 Swap Gateway (8194 -> 8189)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huobao-h3
Group=huobao-h3
EnvironmentFile=/etc/huobao-h3-gateway-swap.env
ExecStart=/usr/bin/python3 /opt/huobao-h3-gateway-swap/h3_gateway.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/huobao-h3-gateway-swap
ProtectHome=true

[Install]
WantedBy=multi-user.target
