# Docker 部署环境变量（复制为 .env 后修改）
# Watchtower HTTP API 令牌，app 与 watchtower 两侧必须一致；生产环境务必修改
WATCHTOWER_TOKEN=please-change-me

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
HUOBAO_VERSION=dev

# 服务器/Docker 主 API 鉴权（强烈建议设置；Basic Auth 或 Bearer Token 任选其一）
# 浏览器界面请使用 HUOBAO_API_USER + HUOBAO_API_PASSWORD（会弹出登录框）；
# HUOBAO_API_TOKEN 仅用于脚本/API 客户端（Authorization: Bearer <token> 或 X-Api-Token）。
# 裸机服务器需显式设置 HOST=0.0.0.0；桌面版和默认启动只监听 127.0.0.1
# HOST=0.0.0.0
HUOBAO_API_USER=
HUOBAO_API_PASSWORD=
HUOBAO_API_TOKEN=

# MCP 默认只监听 127.0.0.1。若要改绑非回环地址，必须同时设置 MCP_ALLOW_REMOTE=1 并自行做网络隔离
# MCP_READONLY=1 时只允许 list/get/preflight 等只读工具，api_request/api_upload 与写操作会被拒绝
# MCP_HOST=127.0.0.1
# MCP_ALLOW_REMOTE=0
# MCP_READONLY=0
